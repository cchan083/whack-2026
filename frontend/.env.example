# Copy to frontend/.env.production (or set in CI) when the frontend is hosted
# separately from the backend, e.g. on GitHub Pages.

# Where the FastAPI backend lives. Leave empty when the backend serves the
# frontend itself (local dev with the Vite proxy, or the Docker image).
VITE_API_URL=https://YOUR-HF-USERNAME-research-gap-finder.hf.space

# Path the site is served from. "/" normally; "/whack-2026/" on GitHub Pages.
VITE_BASE=/
