# Copy this file to .env and fill in real values. Never commit .env.

# Supabase "Session pooler" connection string (host ends in pooler.supabase.com).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: websites allowed to call the API from a browser (comma-separated).
# Defaults to the local dev server and https://cchan083.github.io.
# ALLOWED_ORIGINS=http://localhost:5173,https://cchan083.github.io
